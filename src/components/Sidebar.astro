---
import { mainNavLinks, subNavLinks } from '../data/navLinks'
import ColorDropdown from './ColorDropdown.astro'

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/'

const socialLinks = [
  {
    url: 'mailto:sagar03d@gmail.com',
    label: 'Email',
    iconSvg: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>`,
  },
  {
    url: 'https://github.com/sagar03d',
    label: 'GitHub',
    iconSvg: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>`,
  },
  {
    url: 'https://linkedin.com/in/sagar03d',
    label: 'LinkedIn',
    iconSvg: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>`,
  },
  {
    url: '/rss.xml',
    label: 'RSS feed',
    iconSvg: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 11a9 9 0 0 1 9 9"></path><path d="M4 4a16 16 0 0 1 16 16"></path><circle cx="5" cy="19" r="1"></circle></svg>`,
  },
]
---

<aside class="sidebar">
  <section class="sidebar-section">
    <div class="sidebar-title-link">
      <a href="/" class="flex-align-center gap">
        <span>
          <img
            src="/images/nav-floppy.png"
            class="navbar-logo"
            alt="sagar.dev"
            title="⚡"
            height="16"
            width="16"
          />
        </span>
        <span class="site-name">sagar.dev</span>
      </a>
      <div class="flex-align-center">
        <ColorDropdown />
        <div class="tooltip-container">
          <button
            type="button"
            class="navbar-button theme-toggle-btn"
            aria-label="Toggle dark/light theme"
          >
            <svg class="sun-icon hidden" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
            <svg class="moon-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
          </button>
          <div class="tooltip">Theme</div>
        </div>
      </div>
    </div>
  </section>

  <section class="sidebar-section">
    <div class="sidebar-content">
      <p>
        I'm <a href="/me">Sagar</a>, Senior Full-Stack Engineer with 8+ years experience architecting scalable EdTech & SaaS systems. Welcome to my digital garden. 🌱
      </p>
    </div>
  </section>

  <section class="sidebar-section">
    <nav class="sidebar-nav-links">
      {mainNavLinks.map((link) => {
        const isActive = pathname === link.url || (link.url !== '/' && pathname.startsWith(link.url))
        return (
          <a href={link.url} class={isActive ? 'active' : ''}>
            <img src={link.image} alt="" />
            {link.label}
          </a>
        )
      })}
    </nav>
  </section>

  <div class="sidebar-bottom">
    <section class="sidebar-section">
      <nav class="sidebar-links">
        {socialLinks.map(({ url, label, iconSvg }) => (
          <div class="tooltip-container tooltip-above" key={url}>
            {url.startsWith('http') ? (
              <a
                href={url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={label}
                set:html={iconSvg}
              />
            ) : (
              <a href={url} aria-label={label} set:html={iconSvg} />
            )}
            <div class="tooltip">{label}</div>
          </div>
        ))}
      </nav>
    </section>

    <nav class="sidebar-sub-links">
      {subNavLinks.map((link, index) => {
        const isActive = pathname === link.url || (link.url !== '/' && pathname.startsWith(link.url))
        return (
          <>
            {index > 0 && <div class="divider"></div>}
            {link.url.startsWith('http') ? (
              <a href={link.url} target="_blank" rel="noopener noreferrer">
                {link.label}
              </a>
            ) : (
              <a href={link.url} class={isActive ? 'active' : ''}>
                {link.label}
              </a>
            )}
          </>
        )
      })}
    </nav>
  </div>
</aside>
