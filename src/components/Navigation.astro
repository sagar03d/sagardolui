---
import { mainNavLinks } from '../data/navLinks'
import ColorDropdown from './ColorDropdown.astro'

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/'
---

<header class="navbar">
  <div class="navbar-title">
    <div class="navbar-title-content">
      <a href="/" class="navbar-title-link">
        <span>
          <img
            src="/images/nav-floppy.png"
            class="navbar-logo"
            alt="sagar.dev"
            title="⚡"
            height="16"
            width="16"
          />
        </span>
        <span class="site-name">sagar.dev</span>
      </a>
    </div>
  </div>
  <div class="navbar-container">
    <section class="navbar-section">
      <button
        class="navbar-button nav-menu-button"
        id="mobile-menu-toggle"
        aria-label="Toggle navigation menu"
        type="button"
      >
        <svg class="menu-icon icon-open" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
        <svg class="menu-icon icon-close hidden" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
      <nav class="navbar-menu nav-items" id="mobile-nav-items">
        {mainNavLinks.map((link) => {
          const isActive = pathname === link.url || (link.url !== '/' && pathname.startsWith(link.url))
          return (
            <a
              href={link.url}
              class={isActive ? 'active' : ''}
            >
              <img src={link.image} alt="" />
              {link.label}
            </a>
          )
        })}
      </nav>
      <nav class="navbar-menu social">
        <button
          class="navbar-button theme-toggle-btn"
          aria-label="Toggle dark/light theme"
          type="button"
        >
          <svg class="sun-icon hidden" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
          <svg class="moon-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
        </button>
        <ColorDropdown />
        <a href="https://github.com/sagar03d" target="_blank" rel="noreferrer" class="navbar-icon" aria-label="GitHub">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
        </a>
        <a href="https://linkedin.com/in/sagar03d" target="_blank" rel="noreferrer" class="navbar-icon" aria-label="LinkedIn">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>
        </a>
      </nav>
    </section>
  </div>
</header>

<script>
  function setupNavigation() {
    const menuToggle = document.getElementById('mobile-menu-toggle')
    const menuItems = document.getElementById('mobile-nav-items')
    const iconOpen = menuToggle?.querySelector('.icon-open')
    const iconClose = menuToggle?.querySelector('.icon-close')

    menuToggle?.addEventListener('click', () => {
      const isOpen = menuItems?.classList.toggle('active')
      menuToggle.classList.toggle('active')
      if (isOpen) {
        iconOpen?.classList.add('hidden')
        iconClose?.classList.remove('hidden')
      } else {
        iconOpen?.classList.remove('hidden')
        iconClose?.classList.add('hidden')
      }
    })

    // Theme toggler
    const themeButtons = document.querySelectorAll('.theme-toggle-btn')
    const updateIcons = () => {
      const isLight = document.documentElement.classList.contains('is-light')
      document.querySelectorAll('.sun-icon').forEach((el) => {
        if (isLight) el.classList.remove('hidden')
        else el.classList.add('hidden')
      })
      document.querySelectorAll('.moon-icon').forEach((el) => {
        if (isLight) el.classList.add('hidden')
        else el.classList.remove('hidden')
      })
    }

    updateIcons()

    themeButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const html = document.documentElement
        const isCurrentlyLight = html.classList.contains('is-light')
        const newTheme = isCurrentlyLight ? 'dark' : 'light'

        if (newTheme === 'light') {
          html.classList.add('is-light')
          html.classList.remove('is-dark')
        } else {
          html.classList.add('is-dark')
          html.classList.remove('is-light')
        }

        localStorage.setItem('theme', newTheme)
        html.style.setProperty('color-scheme', newTheme)
        window.dispatchEvent(new CustomEvent('themechange', { detail: { theme: newTheme } }))
        updateIcons()
      })
    })
  }

  setupNavigation()
  document.addEventListener('astro:page-load', setupNavigation)
</script>
