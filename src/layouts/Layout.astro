---
import Navigation from '../components/Navigation.astro'
import Sidebar from '../components/Sidebar.astro'
import Footer from '../components/Footer.astro'
import config from '../utils/config'

import '@fontsource-variable/outfit'
import '@fontsource-variable/google-sans-code'
import '@fontsource-variable/google-sans-code/wght-italic.css'
import '@fontsource-variable/google-sans-flex/slnt.css'
import '../styles/style.css'
import '../styles/new-moon.css'

interface Props {
  title?: string
  description?: string
  image?: string
  isNote?: boolean
  isPost?: boolean
  canonicalUrl?: string
}

const {
  title = config.siteTitle,
  description = config.description,
  image = '/logo.png',
  isNote = false,
  isPost = false,
  canonicalUrl,
} = Astro.props

const pageTitle = title.includes(config.siteAuthor) ? title : `${title} | ${config.siteTitle}`
const currentUrl = canonicalUrl || new URL(Astro.url.pathname, Astro.site || config.siteUrl).href
---

<!doctype html>
<html lang="en" class="is-dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={config.siteAuthor} />
    <link rel="canonical" href={currentUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${config.siteTitle} RSS Feed`} href="/rss.xml" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={currentUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, config.siteUrl).href} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, config.siteUrl).href} />

    <!-- Instant theme & color setup to prevent flash -->
    <script is:inline>
      (() => {
        try {
          const savedTheme = localStorage.getItem('theme') || 'dark';
          const html = document.documentElement;
          if (savedTheme === 'light') {
            html.classList.add('is-light');
            html.classList.remove('is-dark');
          } else {
            html.classList.add('is-dark');
            html.classList.remove('is-light');
          }
          document.documentElement.style.setProperty('color-scheme', savedTheme);

          const savedColor = localStorage.getItem('color');
          if (savedColor) {
            document.documentElement.style.setProperty('--color-primary', savedColor);
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <div id="layout" class="layout">
      <Navigation />
      <Sidebar />
      <div class="main-wrapper">
        <div class={`main-container ${isNote ? 'is-note' : ''}`}>
          <main class={`main-content ${!isPost ? 'page' : ''}`}>
            <slot />
          </main>
          <slot name="sidebar" />
        </div>
        <Footer />
      </div>
    </div>
  </body>
</html>
