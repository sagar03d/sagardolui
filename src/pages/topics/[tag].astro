---
import { getCollection } from 'astro:content'
import Layout from '../../layouts/Layout.astro'
import Hero from '../../components/Hero.astro'
import Posts from '../../components/Posts.astro'
import { slugify, formatTopic, getSimplifiedPosts } from '../../utils/helpers'

export async function getStaticPaths() {
  const allPosts = await getCollection('posts')
  const tagMap = new Map<string, typeof allPosts>()

  allPosts.forEach((post) => {
    const tags = post.data.tags || []
    tags.forEach((tag) => {
      const slug = slugify(tag)
      if (!tagMap.has(slug)) {
        tagMap.set(slug, [])
      }
      tagMap.get(slug)!.push(post)
    })
  })

  return Array.from(tagMap.entries()).map(([slug, posts]) => {
    // Find the original tag name
    const originalTag = posts[0].data.tags?.find((t) => slugify(t) === slug) || slug
    return {
      params: { tag: slug },
      props: { originalTag, posts },
    }
  })
}

const { originalTag, posts } = Astro.props
const sortedPosts = posts.sort((a, b) => {
  const dateA = new Date(a.data.date || 0).getTime()
  const dateB = new Date(b.data.date || 0).getTime()
  return dateB - dateA
})

const simplifiedPosts = getSimplifiedPosts(sortedPosts, { thumbnails: true })
const topicName = formatTopic(originalTag)
const count = simplifiedPosts.length
const message = count === 1 ? ' post' : ' posts'
const description = `All articles and notes on ${topicName} by Sagar Dolui.`
---

<Layout title={topicName} description={description}>
  <Hero
    highlight={count}
    subTitle={message}
    title={topicName}
    type="taxonomy"
    breadcrumb={{ value: '/topics', label: 'Topics' }}
  />
  <Posts data={simplifiedPosts} showYears={true} />
</Layout>
